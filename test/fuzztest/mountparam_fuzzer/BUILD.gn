import("//build/ohos.gni")
import("//build/test.gni")

disk_manager_path = "//foundation/filemanagement/disk_manager"

ohos_fuzztest("MountParamFuzzTest") {
  module_out_path = "disk_manager/disk_manager"
  fuzz_config_file = disk_manager_path + "/test/fuzztest/mountparam_fuzzer"

  include_dirs = [
    disk_manager_path + "/interfaces/innerkits/include",
  ]

  sources = [
    disk_manager_path + "/test/fuzztest/mountparam_fuzzer/mountparam_fuzzer.cpp",
  ]

  configs = [
    disk_manager_path + "/interfaces/innerkits:disk_manager_idl_public_config",
    disk_manager_path + "/common:disk_manager_common_include",
  ]

  defines = [
    "DISK_MANAGER_LOG_TAG = \"DiskManager\"",
    "LOG_DOMAIN = 0xD00430F",
  ]

  deps = [
    disk_manager_path + "/interfaces/innerkits:disk_manager_innerkits",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
  ]

  cflags = [
    "-fno-lto",
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]

  ldflags = [
    "-fno-lto",
  ]

  subsystem_name = "filemanagement"
  part_name = "disk_manager"
}

group("mountparam_fuzztest") {
  testonly = true
  deps = [ ":MountParamFuzzTest" ]
}
